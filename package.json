{
  "name": "ayu-adaptive",
  "displayName": "Ayu Adaptive",
  "description": "A modification of Ayu theme with Atom One, Adapta GTK and macOS Mojave color palette.",
  "version": "0.2.1",
  "publisher": "ccy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/icui/ayu-adaptive"
  },
  "bugs": {
    "url": "https://github.com/icui/ayu-adaptive/issues",
    "email": "libccy@gmail.com"
  },
  "engines": {
    "vscode": "^1.13.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "ayu",
    "one",
    "adapta",
    "mojave"
  ],
  "homepage": "https://github.com/icui/ayu-adaptive",
  "icon": "assets/logo.png",
  "contributes": {
    "themes": [
      {
        "label": "Ayu One",
        "uiTheme": "vs-dark",
        "path": "./ayu-one.json"
      },
      {
        "label": "Ayu Adapta",
        "uiTheme": "vs-dark",
        "path": "./ayu-adapta.json"
      },
      {
        "label": "Ayu Mojave",
        "uiTheme": "vs-dark",
        "path": "./ayu-mojave.json"
      },
      {
        "label": "Ayu One (Dark Separators)",
        "uiTheme": "vs-dark",
        "path": "./ayu-one-dark-separators.json"
      },
      {
        "label": "Ayu Adapta (Dark Separators)",
        "uiTheme": "vs-dark",
        "path": "./ayu-adapta-dark-separators.json"
      },
      {
        "label": "Ayu Mojave (Dark Separators)",
        "uiTheme": "vs-dark",
        "path": "./ayu-mojave-dark-separators.json"
      }
    ]
  },
  "scripts": {
    "build": "node ./build.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "ayu": "4.0.0",
    "vsce": "^1.73.0"
  }
}
